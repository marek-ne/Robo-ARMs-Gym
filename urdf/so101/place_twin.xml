<mujoco model="so101_place_twin">
  <include file="scene.xml"/>
  <!-- impratio and noslip are what make a grasp hold: at the default
       impratio=1 the block slides out from between the blades. -->
  <option impratio="50" noslip_iterations="5"/>
  <worldbody>
    <camera name="classroom" pos="0.04 -0.72 0.50" fovy="52"
            mode="targetbody" target="table"/>
    <!-- Near edge kept out at x=0.12. Any closer and the shoulder's collision
         box rests on the table top, which silently jams the pan joint: the
         position servo winds to its limit while the joint never turns. -->
    <body name="table" pos="0.26 0 0.01">
      <geom name="table_top" type="box" size="0.14 0.16 0.01"
            rgba="0.42 0.36 0.30 1" friction="1.4 0.08 0.01"/>
    </body>
    <body name="pad_a" pos="0.20 0.09 0.021">
      <geom name="pad_a_geom" type="cylinder" size="0.028 0.001"
            rgba="0.15 0.65 0.30 0.45" contype="0" conaffinity="0"/>
    </body>
    <body name="pad_b" pos="0.20 -0.09 0.021">
      <geom name="pad_b_geom" type="cylinder" size="0.028 0.001"
            rgba="0.85 0.25 0.18 0.45" contype="0" conaffinity="0"/>
    </body>
    <body name="cube" pos="0.20 0.09 0.034">
      <freejoint name="cube_free"/>
      <inertial pos="0 0 0" mass="0.025" diaginertia="4e-6 4e-6 4e-6"/>
      <geom name="cube_geom" type="box" size="0.012 0.012 0.012"
            rgba="0.18 0.42 0.82 1" friction="1.8 0.12 0.01"
            condim="4" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    </body>
    <!-- Same RGB handle as reach. The arm's claw follows this marker. -->
    <body name="ee_goal" mocap="true" pos="0.20 0.09 0.14">
      <geom name="ee_goal_sphere" type="sphere" size="0.012"
            rgba="0.25 0.55 0.95 0.85" contype="0" conaffinity="0"/>
      <geom name="ee_goal_x" type="capsule" fromto="-0.035 0 0 0.035 0 0" size="0.0035"
            rgba="0.95 0.20 0.20 0.95" contype="0" conaffinity="0"/>
      <geom name="ee_goal_y" type="capsule" fromto="0 -0.035 0 0 0.035 0" size="0.0035"
            rgba="0.20 0.85 0.30 0.95" contype="0" conaffinity="0"/>
      <geom name="ee_goal_z" type="capsule" fromto="0 0 -0.035 0 0 0.035" size="0.0035"
            rgba="0.25 0.45 0.95 0.95" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
